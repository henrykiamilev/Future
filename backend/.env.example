# Endless Backend Environment Variables
# Copy this file to .env and fill in your values

# App
DEBUG=false

# Firebase (from Firebase Console > Project Settings > Service Accounts)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com

# Gemini (from Google AI Studio)
GEMINI_API_KEY=your-gemini-api-key

# Stripe (from Stripe Dashboard > Developers > API Keys)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_MONTHLY=price_...
STRIPE_PRICE_YEARLY=price_...

# URLs
FRONTEND_URL=https://endless.app
BACKEND_URL=http://localhost:8000
